ACTIVATION_PHRASE="lemon river"
DEACTIVATION_PHRASE="lemon sneeze"
SAVE_PHRASE="lemon save"

# LLM Model Configuration
# pretty good base model
LLM_MODEL="llama3.2"
# if you are using fine-tuning, use whatever you named your fine-tuned model
# LLM_MODEL="lemon-cmd"
# LLM_MODEL="qwen2.5:3b"
# LLM_MODEL="llama3-groq-tool-use"

# LLM parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TOP_P=0.95
LLM_TOP_K=40

# Fine-tuning options
FINE_TUNING_ENABLED=false
FINE_TUNED_MODEL_PATH="fine_tuning/models"

# Logging
LOG_LEVEL=INFO
# LOG_DIR=logs

# Audio Configuration
# MICROPHONE_INDEX=0
# Use "default" or "none" for system default, or a number (0, 1, 2...) for specific device
MICROPHONE_INDEX=default

# Audio Recording Configuration
AUDIO_RECORDING_SAMPLE_RATE=44100
AUDIO_CHUNK_DURATION=0.5
AUDIO_SILENCE_THRESHOLD=0.01
AUDIO_SILENCE_DURATION=1.5
# RECORDINGS_DIR=./recordings

# Application Configuration
DEBUG_MODE=False
MAX_QUEUE_SIZE=0
PROCESS_TIMEOUT=30
